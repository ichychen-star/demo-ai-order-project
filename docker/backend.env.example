# Backend environment variables
# Copy to backend.env and fill in real values — never commit backend.env

# MySQL (when running via Docker Compose, host is 'mysql' not 'localhost')
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/aivehicleorder?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=root

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
